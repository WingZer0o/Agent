{
  "imports": {
    "@std/assert": "jsr:@std/assert@^1",
    "ollama": "npm:ollama@^0.6.3"
  },
  "tasks": {
    "start": "deno run --allow-net=127.0.0.1:11434,localhost:11434 --allow-env=OLLAMA_HOST index.ts",
    "dev": "deno run --watch --allow-net=127.0.0.1:11434,localhost:11434 --allow-env=OLLAMA_HOST index.ts",
    "check": "deno check index.ts index_test.ts",
    "lint": "deno lint",
    "fmt": "deno fmt --check",
    "test": "deno test"
  },
  "fmt": {
    "singleQuote": true,
    "semiColons": false,
    "lineWidth": 100
  },
  "lint": {
    "rules": {
      "tags": ["recommended"]
    }
  }
}
